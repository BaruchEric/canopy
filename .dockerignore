# installed and built fresh in the image
node_modules
dist
# not needed to build or run, and large
.git
ui/node_modules
# local scratch that must never enter the image
*.log
.DS_Store
# compose reads these on the host (GH_TOKEN, the gateway key, TS_AUTHKEY);
# in the image they would sit in a layer, and bun loads a .env from /app
.env
.env.*
# what the map section writes when the repo it reads is canopy's own
# checkout: the map, the diagrams and the diagnosis (tens of MB), the graph.
# In the build context they would change the image on every analysis.
floorplan
.archify
.ua
.understand-anything
