{
  "name": "canopy",
  "version": "0.2.0",
  "description": "Multi-repo git cockpit: point it at a directory, see every repo as a live tree, drill into changes, commit/push with AI-suggested messages, open repos in kitty/VS Code, group them into workspaces.",
  "homepage": "https://github.com/BaruchEric/canopy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaruchEric/canopy.git"
  },
  "type": "module",
  "bin": {
    "canopy": "bin/canopy.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "dev:web": "vite ui",
    "build": "vite build ui",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json",
    "lint": "oxlint src ui/src bin",
    "test": "bun test",
    "redeploy": "bash scripts/redeploy.sh"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.103",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.127",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.86.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
