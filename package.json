{
  "name": "canopy",
  "version": "0.2.0",
  "description": "Multi-repo git cockpit: point it at a directory, see every repo as a live tree, drill into changes, commit/push with AI-suggested messages, open repos in kitty/VS Code, group them into workspaces.",
  "homepage": "https://github.com/BaruchEric/canopy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaruchEric/canopy.git"
  },
  "type": "module",
  "bin": {
    "canopy": "bin/canopy.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "dev:web": "vite ui",
    "build": "vite build ui && vite build ui --config ui/vite.sw.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p ui/tsconfig.sw.json",
    "lint": "oxlint src ui/src ui/sw.ts bin scripts",
    "test": "bun test",
    "redeploy": "bash scripts/redeploy.sh"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.126",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "age-encryption": "0.3.1",
    "ai": "^7.0.153",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^16.4.2",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
